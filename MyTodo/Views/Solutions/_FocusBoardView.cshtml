@model List<SolutionDto>
@{
    var focusGroups = new[]
    {
        (Key: true, Title: "20% (Focus)", BadgeClass: "bg-warning text-dark", GroupName: "twentyPercent"),
        (Key: false, Title: "Normal", BadgeClass: "bg-secondary", GroupName: "normal")
    };
}

<div id="focusView">
    <div class="d-flex justify-content-end mb-2">
        <button type="button" id="focusSwapColumnsBtn" class="btn btn-sm btn-outline-secondary">&#8646; Swap Columns</button>
    </div>
    <div class="row row-cols-1 row-cols-md-2 g-3">
        @foreach (var group in focusGroups)
        {
            var solutionsInGroup = Model.Where(s => s.IsTwentyPercent == group.Key).ToList();
            <div class="col" data-group="@group.GroupName">
                <div class="kanban-column bg-body-tertiary rounded p-2 h-100" data-twenty-percent="@group.Key.ToString().ToLowerInvariant()">
                    <h6 class="d-flex justify-content-between align-items-center mb-3">
                        <span>@group.Title</span>
                        <span class="badge kanban-count-badge @group.BadgeClass">@solutionsInGroup.Count</span>
                    </h6>
                    <div class="kanban-cards">
                        <p class="text-muted small mb-0 kanban-empty-hint" style="display:@(solutionsInGroup.Any() ? "none" : "block")">No solutions.</p>
                        @foreach (var solution in solutionsInGroup)
                        {
                            <div class="card kanban-card mb-2 shadow-sm" draggable="true" data-solution-id="@solution.Id">
                                <div class="card-body py-2 px-3">
                                    <h6 class="card-title mb-1">@solution.Name</h6>
                                    <p class="card-text small text-muted mb-0 mb-2">
                                        @(string.IsNullOrWhiteSpace(solution.Description) ? "No description provided." : solution.Description)
                                    </p>
                                    <span class="badge @SolutionStatusDisplay.GetBadgeClass(solution.Status)">@SolutionStatusDisplay.GetText(solution.Status)</span>
                                    <a asp-controller="Objectives" asp-action="Index" asp-route-solutionId="@solution.Id" class="btn btn-sm btn-outline-primary">Details</a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
