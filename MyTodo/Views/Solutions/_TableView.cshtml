@model List<SolutionDto>

<div id="tableView" class="table-responsive d-none">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Status</th>
                <th>20%</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var solution in Model)
            {
                <tr data-solution-id="@solution.Id">
                    <td>@solution.Name</td>
                    <td>@(string.IsNullOrWhiteSpace(solution.Description) ? "No description provided." : solution.Description)</td>
                    <td><span class="badge @SolutionStatusDisplay.GetBadgeClass(solution.Status)">@SolutionStatusDisplay.GetText(solution.Status)</span></td>
                    <td>
                        <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle twenty-percent-badge @(solution.IsTwentyPercent ? "" : "d-none")">20%</span>
                    </td>
                    <td>
                        <a asp-controller="Objectives" asp-action="Index" asp-route-solutionId="@solution.Id" class="btn btn-sm btn-outline-secondary">Detail</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
