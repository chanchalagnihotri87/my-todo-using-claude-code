@model CreateSolutionViewModel
@{
    var problem = (ProblemDto)ViewBag.Problem;
    ViewData["Title"] = "Add Solution";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Add Solution</h1>
        <p class="text-muted mb-0">Problem: @problem.Name</p>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ProblemId" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsTwentyPercent" class="form-check-input" />
                <label asp-for="IsTwentyPercent" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" asp-route-problemId="@problem.Id" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
