<div class="modal fade" id="editSprintModal" tabindex="-1" aria-labelledby="editSprintModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editSprintForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="editSprintModalLabel">Edit Sprint</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="editSprintError" class="alert alert-danger d-none" role="alert"></div>

                    <input type="hidden" id="editSprintId" name="id" />

                    <div class="mb-3">
                        <label for="editSprintName" class="form-label">Name</label>
                        <input type="text" class="form-control" id="editSprintName" name="name" maxlength="200" required />
                    </div>

                    <div class="mb-3">
                        <label for="editSprintDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="editSprintDescription" name="description" rows="3" maxlength="1000"></textarea>
                    </div>

                    <div class="row">
                        <div class="col mb-3">
                            <label for="editSprintStartDate" class="form-label">Start Date</label>
                            <input type="date" class="form-control" id="editSprintStartDate" name="startDate" required />
                        </div>
                        <div class="col mb-3">
                            <label for="editSprintEndDate" class="form-label">End Date</label>
                            <input type="date" class="form-control" id="editSprintEndDate" name="endDate" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
