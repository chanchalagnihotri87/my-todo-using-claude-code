@model List<SprintDto>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Sprints";
    var antiForgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}

<input type="hidden" id="sprintAntiForgeryToken" value="@antiForgeryToken" />

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Sprints</h1>
    <div class="d-flex align-items-center gap-2">
        <a asp-controller="Sprints" asp-action="Index" class="btn btn-outline-secondary">Current Sprint</a>
        <button type="button" class="btn btn-primary add-sprint-btn">Add Sprint</button>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        No sprints have been created yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sprint in Model)
                {
                    <tr data-sprint-id="@sprint.Id">
                        <td>@sprint.Name</td>
                        <td>@(string.IsNullOrWhiteSpace(sprint.Description) ? "No description provided." : sprint.Description)</td>
                        <td>@sprint.StartDate.ToString("MMM d, yyyy")</td>
                        <td>@sprint.EndDate.ToString("MMM d, yyyy")</td>
                        <td>@sprint.CreatedAt.ToString("MMM d, yyyy")</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <a asp-controller="Sprints" asp-action="Details" asp-route-id="@sprint.Id" class="btn btn-sm btn-outline-primary">Details</a>
                                <button type="button" class="btn btn-sm btn-outline-secondary edit-sprint-btn"
                                        data-id="@sprint.Id"
                                        data-name="@sprint.Name"
                                        data-description="@sprint.Description"
                                        data-start-date="@sprint.StartDate.ToString("yyyy-MM-dd")"
                                        data-end-date="@sprint.EndDate.ToString("yyyy-MM-dd")">
                                    Edit
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger delete-sprint-btn" data-id="@sprint.Id" data-name="@sprint.Name">
                                    Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<partial name="_AddSprintModal" />
<partial name="_EditSprintModal" />
<partial name="_DeleteSprintModal" />

@section Scripts {
    <script src="~/js/sprints-index.js" asp-append-version="true"></script>
}
