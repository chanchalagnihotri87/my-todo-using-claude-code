<div class="modal fade" id="addSprintModal" tabindex="-1" aria-labelledby="addSprintModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="addSprintForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="addSprintModalLabel">Add Sprint</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="addSprintError" class="alert alert-danger d-none" role="alert"></div>

                    <div class="mb-3">
                        <label for="newSprintName" class="form-label">Name</label>
                        <input type="text" class="form-control" id="newSprintName" maxlength="200" required />
                    </div>

                    <div class="mb-3">
                        <label for="newSprintDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="newSprintDescription" maxlength="1000" rows="3"></textarea>
                    </div>

                    <div class="row">
                        <div class="col mb-3">
                            <label for="newSprintStartDate" class="form-label">Start Date</label>
                            <input type="date" class="form-control" id="newSprintStartDate" required />
                        </div>
                        <div class="col mb-3">
                            <label for="newSprintEndDate" class="form-label">End Date</label>
                            <input type="date" class="form-control" id="newSprintEndDate" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add</button>
                </div>
            </form>
        </div>
    </div>
</div>
