@model CreateProblemViewModel
@{
    var lifeArea = (LifeAreaDto)ViewBag.LifeArea;
    ViewData["Title"] = "Add Problem";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Add Problem</h1>
        <p class="text-muted mb-0">Life Area: @lifeArea.Name</p>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="LifeAreaId" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" asp-route-lifeAreaId="@lifeArea.Id" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
