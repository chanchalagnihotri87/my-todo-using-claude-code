@model List<ProblemDto>
@{
    var lifeArea = (LifeAreaDto)ViewBag.LifeArea;
    ViewData["Title"] = $"Problems - {lifeArea.Name}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Problems</h1>
        <p class="text-muted mb-0">Life Area: @lifeArea.Name</p>
    </div>
    <div>
        <a asp-action="Create" asp-route-lifeAreaId="@lifeArea.Id" class="btn btn-primary">Add Problem</a>
        <a asp-controller="LifeAreas" asp-action="Index" class="btn btn-secondary">Back to Life Areas</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        No problems have been added to this life area yet.
    </div>
}
else
{
    <div class="d-flex justify-content-end mb-3">
        <div class="btn-group" role="group" aria-label="View toggle">
            <button type="button" id="cardViewBtn" class="btn btn-sm btn-outline-primary active view-toggle-btn" data-view="card">Cards</button>
            <button type="button" id="tableViewBtn" class="btn btn-sm btn-outline-primary view-toggle-btn" data-view="table">Table</button>
            <button type="button" id="boardViewBtn" class="btn btn-sm btn-outline-primary view-toggle-btn" data-view="board">Board</button>
        </div>
    </div>

    <div id="cardView" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var problem in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">@problem.Name</h5>
                            <span class="badge @ProblemStatusDisplay.GetBadgeClass(problem.Status)">@ProblemStatusDisplay.GetText(problem.Status)</span>
                        </div>
                        <p class="card-text">
                            @(string.IsNullOrWhiteSpace(problem.Description) ? "No description provided." : problem.Description)
                        </p>
                        <partial name="_ProblemTagBadges" model="problem" />
                    </div>
                    <div class="card-footer text-muted small">
                        Created @problem.CreatedAt.ToString("MMM d, yyyy")
                    </div>
                </div>
            </div>
        }
    </div>

    <partial name="_TableView" model="Model" />

    <partial name="_BoardView" model="Model" />
}

@section Styles {
    <link rel="stylesheet" href="~/css/problems-index.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/problems-index.js" asp-append-version="true"></script>
}
