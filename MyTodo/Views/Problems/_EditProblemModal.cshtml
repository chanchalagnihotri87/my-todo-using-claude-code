@using MyTodo.Domain.Shared.Enums
@using MyTodo.Helpers

<div class="modal fade" id="editProblemModal" tabindex="-1" aria-labelledby="editProblemModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editProblemForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="editProblemModalLabel">Edit Problem</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="editProblemError" class="alert alert-danger d-none" role="alert"></div>

                    <input type="hidden" id="editProblemId" name="id" />

                    <div class="mb-3">
                        <label for="editProblemName" class="form-label">Name</label>
                        <input type="text" class="form-control" id="editProblemName" name="name" maxlength="200" required />
                    </div>

                    <div class="mb-3">
                        <label for="editProblemDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="editProblemDescription" name="description" rows="4" maxlength="1000"></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="editProblemStatus" class="form-label">Status</label>
                        <select class="form-select" id="editProblemStatus" name="status">
                            @foreach (var status in Enum.GetValues<ProblemStatus>())
                            {
                                <option value="@status">@ProblemStatusDisplay.GetText(status)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="editProblemIsUrgent" name="isUrgent" />
                        <label class="form-check-label" for="editProblemIsUrgent">Urgent</label>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="editProblemIsImportant" name="isImportant" />
                        <label class="form-check-label" for="editProblemIsImportant">Important</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
