<div class="modal fade" id="deleteObjectiveModal" tabindex="-1" aria-labelledby="deleteObjectiveModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteObjectiveModalLabel">Delete Objective</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="deleteObjectiveError" class="alert alert-danger d-none" role="alert"></div>
                <p class="mb-0">
                    Delete "<strong id="deleteObjectiveText"></strong>"? This cannot be undone.
                </p>
                <input type="hidden" id="deleteObjectiveId" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirmDeleteObjectiveBtn" class="btn btn-danger">Delete</button>
            </div>
        </div>
    </div>
</div>
