@model List<ObjectiveDto>

<div id="tableView" class="table-responsive d-none">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Text</th>
                <th>Status</th>
                <th>Focus</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var objective in Model)
            {
                <tr data-objective-id="@objective.Id">
                    <td>
                        <span class="@(objective.Status == ObjectiveStatus.Completed ? "text-muted" : "")">@objective.Text</span>
                    </td>
                    <td><span class="badge @ObjectiveStatusDisplay.GetBadgeClass(objective.Status)">@ObjectiveStatusDisplay.GetText(objective.Status)</span></td>
                    <td>
                        <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle twenty-percent-badge @(objective.IsTwentyPercent ? "" : "d-none")">20%</span>
                    </td>
                    <td>
                        <div class="btn-group">
                            <a asp-controller="Tasks" asp-action="Index" asp-route-objectiveId="@objective.Id" class="btn btn-sm btn-outline-secondary">Detail</a>
                            <button type="button" class="btn btn-sm btn-outline-secondary edit-objective-btn"
                                    data-id="@objective.Id"
                                    data-text="@objective.Text"
                                    data-status="@objective.Status">
                                Edit
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary objective-delete" data-objective-id="@objective.Id" data-text="@objective.Text" aria-label="Delete objective">Delete</button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
