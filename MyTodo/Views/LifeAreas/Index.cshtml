@model List<LifeAreaDto>
@{
    ViewData["Title"] = "Life Areas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Life Areas</h1>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        No life areas have been created yet.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var lifeArea in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@lifeArea.Name</h5>
                        <p class="card-text">
                            @(string.IsNullOrWhiteSpace(lifeArea.Description) ? "No description provided." : lifeArea.Description)
                        </p>
                    </div>
                    <div class="card-footer text-muted small">
                        Created @lifeArea.CreatedAt.ToString("MMM d, yyyy")
                    </div>
                </div>
            </div>
        }
    </div>
}
