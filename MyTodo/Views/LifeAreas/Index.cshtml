@model List<LifeAreaDto>
@{
    ViewData["Title"] = "Life Areas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Life Areas</h1>
    <a asp-action="Create" class="btn btn-primary">Add Life Area</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        No life areas have been created yet.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var lifeArea in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm position-relative">
                    <div class="dropdown position-absolute top-0 end-0 mt-2 me-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary border-0 lh-1" data-bs-toggle="dropdown" aria-expanded="false">
                            &vellip;
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@lifeArea.Id">Edit</a></li>
                            <li>
                                <form asp-action="Delete" asp-route-id="@lifeArea.Id" method="post"
                                      onsubmit="return confirm('Delete &quot;@lifeArea.Name&quot;? This cannot be undone.');">
                                    <button type="submit" class="dropdown-item text-danger">Delete</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title pe-4">@lifeArea.Name</h5>
                        <p class="card-text">
                            @(string.IsNullOrWhiteSpace(lifeArea.Description) ? "No description provided." : lifeArea.Description)
                        </p>
                    </div>
                    <div class="card-footer d-flex justify-content-end align-items-center">
                        <a asp-controller="Problems" asp-action="Index" asp-route-lifeAreaId="@lifeArea.Id" class="btn btn-sm btn-outline-secondary">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
