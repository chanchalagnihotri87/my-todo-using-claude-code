@model List<LifeAreaDto>
@{
    ViewData["Title"] = "Life Areas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Life Areas</h1>
    <a asp-action="Create" class="btn btn-primary">Add Life Area</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        No life areas have been created yet.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var lifeArea in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@lifeArea.Name</h5>
                        <p class="card-text">
                            @(string.IsNullOrWhiteSpace(lifeArea.Description) ? "No description provided." : lifeArea.Description)
                        </p>
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center text-muted small">
                        <span>Created @lifeArea.CreatedAt.ToString("MMM d, yyyy")</span>
                        <div class="d-flex gap-2">
                            <a asp-controller="Problems" asp-action="Index" asp-route-lifeAreaId="@lifeArea.Id" class="btn btn-sm btn-outline-primary">View Details</a>
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@lifeArea.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <form asp-action="Delete" asp-route-id="@lifeArea.Id" method="post"
                                      onsubmit="return confirm('Delete &quot;@lifeArea.Name&quot;? This cannot be undone.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
