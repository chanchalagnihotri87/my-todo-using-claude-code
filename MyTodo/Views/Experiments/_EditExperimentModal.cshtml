@using MyTodo.Domain.Shared.Enums
@using MyTodo.Helpers

<div class="modal fade" id="editExperimentModal" tabindex="-1" aria-labelledby="editExperimentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editExperimentForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="editExperimentModalLabel">Edit Experiment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="editExperimentError" class="alert alert-danger d-none" role="alert"></div>

                    <input type="hidden" id="editExperimentId" name="id" />

                    <div class="mb-3">
                        <label for="editExperimentName" class="form-label">Name</label>
                        <input type="text" class="form-control" id="editExperimentName" name="name" maxlength="200" required />
                    </div>

                    <div class="mb-3">
                        <label for="editExperimentDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="editExperimentDescription" name="description" rows="3" maxlength="1000"></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="editExperimentStatus" class="form-label">Status</label>
                        <select class="form-select" id="editExperimentStatus" name="status">
                            @foreach (var status in Enum.GetValues<ExperimentStatus>())
                            {
                                <option value="@status">@ExperimentStatusDisplay.GetText(status)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
