@model List<TodoDto>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Todo History";
    var objectives = (List<ObjectiveDto>)ViewBag.Objectives;
    int? selectedObjectiveId = ViewBag.SelectedObjectiveId;
    DateOnly? selectedDate = ViewBag.SelectedDate;
    string? selectedWeek = ViewBag.SelectedWeek;
    var antiForgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}

<input type="hidden" id="todosAntiForgeryToken" value="@antiForgeryToken" />

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Todo History</h1>
    <a asp-controller="Todos" asp-action="Index" class="btn btn-secondary">Back to Today</a>
</div>

<form method="get" asp-controller="Todos" asp-action="History" class="row row-cols-lg-auto g-2 align-items-end mb-4">
    <div class="col-12">
        <label for="historyObjectiveId" class="form-label">Objective</label>
        <select id="historyObjectiveId" name="objectiveId" class="form-select">
            <option value="">All Objectives</option>
            @foreach (var objective in objectives)
            {
                <option value="@objective.Id" selected="@(selectedObjectiveId == objective.Id ? "selected" : null)">@objective.Text</option>
            }
        </select>
    </div>
    <div class="col-12">
        <label for="historyDate" class="form-label">Date</label>
        <input type="date" id="historyDate" name="date" class="form-control" value="@(selectedDate?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="col-12">
        <label for="historyWeek" class="form-label">Week</label>
        <input type="week" id="historyWeek" name="week" class="form-control" value="@selectedWeek" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a asp-controller="Todos" asp-action="History" class="btn btn-outline-secondary">Clear Filters</a>
    </div>
    <div class="col-12">
        <small class="text-muted">Picking a week overrides the date field.</small>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        No todo history matches the selected filters.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th class="reorder-handle-col"></th>
                    <th>Date</th>
                    <th>Task</th>
                    <th>Objective</th>
                    <th>Sprint</th>
                    <th>Status</th>
                    <th>Completed At</th>
                </tr>
            </thead>
            <tbody id="todosHistoryTableBody">
                @foreach (var todo in Model)
                {
                    <tr class="todo-history-row" data-todo-id="@todo.Id" data-todo-date="@todo.TodoDate.ToString("yyyy-MM-dd")" draggable="true">
                        <td class="reorder-handle-col">
                            <span class="reorder-handle" title="Drag to reorder within this date">&#9776;</span>
                        </td>
                        <td>@todo.TodoDate.ToString("ddd, dd-MMM-yyyy")</td>
                        <td>@todo.TodoTaskName</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span>@todo.ObjectiveText</span>
                                <a asp-controller="Tasks" asp-action="Index" asp-route-objectiveId="@todo.ObjectiveId" class="btn btn-sm btn-outline-secondary py-0 px-2" title="View Tasks">&rarr;</a>
                            </div>
                        </td>
                        <td>@(todo.SprintName ?? "—")</td>
                        <td><span class="badge @TodoStatusDisplay.GetBadgeClass(todo.TaskStatus)">@TodoStatusDisplay.GetText(todo.TaskStatus)</span></td>
                        <td>@(todo.CompletedAt?.ToString("MMM d, yyyy") ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Styles {
    <link rel="stylesheet" href="~/css/todos-index.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/todos-index.js" asp-append-version="true"></script>
}
