@model List<TodoDto>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Today's Todo";
    var antiForgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
}

<input type="hidden" id="todosAntiForgeryToken" value="@antiForgeryToken" />

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Today's Todo</h1>
        <p class="text-muted mb-0">@today.ToString("dddd, dd-MMM-yyyy")</p>
    </div>
    <div>
        <a asp-controller="Todos" asp-action="History" class="btn btn-secondary">History</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        Nothing scheduled in your Todo list for today.
    </div>
}
else
{
    <div class="d-flex justify-content-end mb-3">
        <div class="btn-group" role="group" aria-label="View toggle">
            <button type="button" id="tableViewBtn" class="btn btn-sm btn-outline-primary active view-toggle-btn" data-view="table">Table</button>
            <button type="button" id="boardViewBtn" class="btn btn-sm btn-outline-primary view-toggle-btn" data-view="board">Board</button>
        </div>
    </div>

    <partial name="_TableView" model="Model" />

    <partial name="_BoardView" model="Model" />
}

@section Styles {
    <link rel="stylesheet" href="~/css/todos-index.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/todos-index.js" asp-append-version="true"></script>
}
