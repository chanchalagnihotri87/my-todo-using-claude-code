@model List<LifeAreaDto>
@{
    ViewData["Title"] = "Explore";
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h1>Explore</h1>
    <a asp-controller="LifeAreas" asp-action="Index" class="btn btn-secondary">Manage Life Areas</a>
</div>
<p class="text-muted small mb-4">Life Area &rarr; Problem &rarr; Solution &rarr; Objective &rarr; Task. Click a row to expand it.</p>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        No life areas have been created yet.
    </div>
}
else
{
    <div class="tree tree-level-0">
        @foreach (var lifeArea in Model)
        {
            <div class="tree-node">
                <div class="tree-node-header" role="button" aria-expanded="false">
                    <div class="row gx-2 align-items-center flex-nowrap">
                        <div class="col-1 tree-type-label">Life Area</div>
                        <div class="col-4 tree-col-name">
                            <span class="tree-node-label">@lifeArea.Name</span>
                        </div>
                        <div class="col-5 tree-status-group"></div>
                        <div class="col-2 tree-actions">
                            <span class="tree-arrow"></span>
                        </div>
                    </div>
                </div>
                <div class="tree-children d-none" data-url="@Url.Action("Problems", "Explore", new { lifeAreaId = lifeArea.Id })"></div>
            </div>
        }
    </div>
}

@section Styles {
    <link rel="stylesheet" href="~/css/explore.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/explore.js" asp-append-version="true"></script>
}
